#!/usr/bin/env bash
#MISE description="Link CLAUDE.md and .claude/skills to AGENTS.md and .agents/skills for Claude Code"
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?run this through mise}"

# link TARGET PATH: create PATH as a symlink to TARGET (relative to PATH's directory).
# Safe to rerun; never replaces an existing file or a link that points elsewhere.
link() {
  local target=$1 path=$2
  if [ -L "$path" ]; then
    if [ "$(readlink "$path")" = "$target" ]; then
      echo "ok:      $path -> $target"
      return
    fi
    echo "error:   $path links to $(readlink "$path"), expected $target" >&2
    return 1
  elif [ -e "$path" ]; then
    echo "error:   $path exists and is not a symlink; move it aside first" >&2
    return 1
  fi
  mkdir -p "$(dirname "$path")"
  ln -s "$target" "$path"
  echo "created: $path -> $target"
}

link AGENTS.md CLAUDE.md
link ../.agents/skills .claude/skills
